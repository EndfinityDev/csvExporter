[
  // This is another example file with a different supported structure
  {
    "my_random_value": "Extra things can be added, they have no effect",
    "type": "str", // str is a valid type too as an alias to string
    "label": "No tooltip",
    "luaName": "no_tooltip",
    "save": true // If true, the input will be saved and automatically restored when the export menu is opened. Defaults to false
  },
  {
    "type": "string",
    "luaName": "my_parameter",
    "tooltip": "No label - luaName is used instead, plus more wildcard defaults",
    "defaultValue": "[PlayerName] [PlatformName] [TrimName]",
    "save": false
  },
  {
    "type": "none",
    "label": "Incorrect entry",
    "tooltip": "Incorrect entries will simply be ignored"
  },
  {
    "label": "This one too!"
  },
  {
    "type": "string",
    "label": "No luaName",
    "tooltip": "luaName is required, this will be ignored as well"
  },
  {
    "type": "boolean", // bool and boolean are both valid
    "tooltip": "Default True Boolean",
    "luaName": "default_true_boolean",
    "defaultValue": true,
    "save": true
  }
]