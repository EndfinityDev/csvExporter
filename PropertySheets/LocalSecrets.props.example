<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <CSVE_VERSIONCHECK_VERIFY_CERT>1</CSVE_VERSIONCHECK_VERIFY_CERT>
    <CSVE_VERSIONCHECK_UPDATE_URL>L"https://github.com/EndfinityDev/csvExporter/releases"</CSVE_VERSIONCHECK_UPDATE_URL>
    <CSVE_HTTP_API_KEY>"YOUR_API_KEY_HERE"</CSVE_HTTP_API_KEY>
    <CSVE_VERSIONCHECK_TARGET_URL_HOST>"http://localhost:80"</CSVE_VERSIONCHECK_TARGET_URL_HOST>
    <CSVE_VERSIONCHECK_TARGET_URL_PATH>"/v1/version"</CSVE_VERSIONCHECK_TARGET_URL_PATH>
    <CSVE_VERSIONCHECK_TARGET_URL_PARAMS>{ "branch", "release" }</CSVE_VERSIONCHECK_TARGET_URL_PARAMS>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>CSVE_VERSIONCHECK_TARGET_URL_HOST=$(CSVE_VERSIONCHECK_TARGET_URL_HOST);CSVE_VERSIONCHECK_TARGET_URL_PATH=$(CSVE_VERSIONCHECK_TARGET_URL_PATH);CSVE_VERSIONCHECK_TARGET_URL_PARAMS=$(CSVE_VERSIONCHECK_TARGET_URL_PARAMS);CSVE_VERSIONCHECK_VERIFY_CERT=$(CSVE_VERSIONCHECK_VERIFY_CERT);CSVE_VERSIONCHECK_UPDATE_URL=$(CSVE_VERSIONCHECK_UPDATE_URL);CSVE_HTTP_API_KEY=$(CSVE_HTTP_API_KEY);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="CSVE_VERSIONCHECK_VERIFY_CERT">
      <Value>$(CSVE_VERSIONCHECK_VERIFY_CERT)</Value>
    </BuildMacro>
    <BuildMacro Include="CSVE_VERSIONCHECK_UPDATE_URL">
      <Value>$(CSVE_VERSIONCHECK_UPDATE_URL)</Value>
    </BuildMacro>
    <BuildMacro Include="CSVE_HTTP_API_KEY">
      <Value>$(CSVE_HTTP_API_KEY)</Value>
    </BuildMacro>
    <BuildMacro Include="CSVE_VERSIONCHECK_TARGET_URL_HOST">
      <Value>$(CSVE_VERSIONCHECK_TARGET_URL_HOST)</Value>
    </BuildMacro>
    <BuildMacro Include="CSVE_VERSIONCHECK_TARGET_URL_PATH">
      <Value>$(CSVE_VERSIONCHECK_TARGET_URL_PATH)</Value>
    </BuildMacro>
    <BuildMacro Include="CSVE_VERSIONCHECK_TARGET_URL_PARAMS">
      <Value>$(CSVE_VERSIONCHECK_TARGET_URL_PARAMS)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>